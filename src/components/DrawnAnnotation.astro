---
interface Props {
  text: string;
  /** Use \n for an explicit line break in the handwritten note. */
  note: string;
  /** The phrase the arrow starts from; defaults to the last word. */
  anchor?: string;
}

const { text, note, anchor = text.match(/\S+$/)?.[0] ?? text } = Astro.props;
const anchorIndex = text.lastIndexOf(anchor);
if (!anchor || anchorIndex < 0) {
  throw new Error('DrawnAnnotation anchor must be a non-empty phrase within text.');
}
const beforeAnchor = text.slice(0, anchorIndex);
const afterAnchor = text.slice(anchorIndex + anchor.length);
---

<div class="annotated-transition" data-drawn-annotation>
  <p><strong>{beforeAnchor}<span data-arrow-origin>{anchor}</span>{afterAnchor}</strong></p>
  <svg class="annotation-arrow" viewBox="0 0 160 60" fill="none" aria-hidden="true" focusable="false">
    <path class="arrow-shaft" pathLength="1" d="M4 32 Q78 22 152 30" />
    <path class="arrow-head" pathLength="1" d="M145 26 L152 30 L145 33" />
  </svg>
  <p class="handwritten-note"><span class="handwritten-text" data-arrow-target>{note}</span></p>
</div>


<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLElement>('[data-drawn-annotation]').forEach((annotation) => {
    const origin = annotation.querySelector<HTMLElement>('[data-arrow-origin]')!;
    const target = annotation.querySelector<HTMLElement>('[data-arrow-target]')!;
    const arrow = annotation.querySelector<SVGSVGElement>('.annotation-arrow')!;
    const shaft = arrow.querySelector<SVGPathElement>('.arrow-shaft')!;
    const head = arrow.querySelector<SVGPathElement>('.arrow-head')!;

    const positionArrow = () => {
      const box = annotation.getBoundingClientRect();
      // A wrapped anchor has one rect per line; start at its final fragment.
      const fragments = origin.getClientRects();
      const from = fragments[fragments.length - 1] ?? origin.getBoundingClientRect();
      const sx = from.left - box.left + from.width / 2;
      const sy = from.bottom - box.top + 4;

      // Keep the note under its anchor while keeping the entire note in the column.
      const noteWidth = target.offsetWidth;
      const offset = Math.max(0, Math.min(sx - noteWidth / 2, box.width - noteWidth));
      target.style.setProperty('--note-offset', `${offset}px`);
      const to = target.getBoundingClientRect();
      const tx = Math.max(to.left - box.left + 6, Math.min(sx, to.right - box.left - 6));
      const ty = to.top - box.top - 7;
      const gap = Math.max(1, ty - sy);
      const bend = Math.min(8, gap * 0.2);
      const cx = Math.max(2, Math.min(box.width - 2, sx + bend));
      const cy = ty - gap * 0.4;
      shaft.setAttribute('d', `M${sx} ${sy} C${cx} ${sy + gap * 0.4} ${tx + bend} ${cy} ${tx} ${ty}`);
      const angle = Math.atan2(ty - cy, -bend);
      const wing = (offset: number) => `${tx - 6 * Math.cos(angle + offset)} ${ty - 6 * Math.sin(angle + offset)}`;
      head.setAttribute('d', `M${wing(0.45)} L${tx} ${ty} L${wing(-0.5)}`);
      arrow.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
      arrow.setAttribute('data-positioned', '');
    };

    positionArrow();
    const resizeObserver = new ResizeObserver(positionArrow);
    resizeObserver.observe(annotation);
    resizeObserver.observe(target);
    resizeObserver.observe(origin.closest('p')!);
    window.addEventListener('resize', positionArrow);
    document.fonts.ready.then(positionArrow);

    if (!reducedMotion.matches && 'IntersectionObserver' in window) {
      annotation.classList.add('draw-ready');
      const observer = new IntersectionObserver((entries) => {
        if (entries.some(entry => entry.isIntersecting)) {
          annotation.classList.add('is-drawn');
          observer.disconnect();
        }
      }, { threshold: 0.5, rootMargin: '0px 0px -12% 0px' });
      observer.observe(annotation);
      reducedMotion.addEventListener('change', (event) => {
        if (event.matches) {
          annotation.classList.remove('draw-ready');
          observer.disconnect();
        }
      });
    }
  });
</script>
